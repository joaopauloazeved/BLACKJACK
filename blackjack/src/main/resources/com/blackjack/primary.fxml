<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.blackjack.client.controllers.ClientController">
   <top>
      <VBox>
         <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
            <Label text="♣" styleClass="brand-mark" />
            <Label text="BLACKJACK 21" styleClass="brand" />
            <Label text="ARCADE TABLE  /  MULTIPLAYER" styleClass="section-kicker" />
            <Label fx:id="connectionLabel" text="OFFLINE" styleClass="connection-label" HBox.hgrow="ALWAYS" />
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10" styleClass="connection-strip">
            <Label text="SERVIDOR" styleClass="field-label" />
            <TextField fx:id="serverIpField" prefWidth="175" text="localhost" promptText="IP do servidor" />
            <Label text="JOGADOR" styleClass="field-label" />
            <TextField fx:id="playerNameField" prefWidth="190" promptText="Seu nome" />
            <Button fx:id="connectButton" text="CONECTAR" onAction="#onConnect" />
         </HBox>
      </VBox>
   </top>

   <center>
      <VBox spacing="12" styleClass="table-area">
         <VBox spacing="10" styleClass="dealer-panel">
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="dealer-heading">
               <Label text="01  /  DEALER" styleClass="dealer-title" />
               <Label fx:id="dealerScoreLabel" text="PONTUAÇÃO  /  --" styleClass="score-label" />
            </HBox>
            <HBox fx:id="dealerCards" spacing="10" styleClass="card-row" />
         </VBox>

         <HBox alignment="CENTER_LEFT" styleClass="status-strip">
            <Label fx:id="phaseLabel" text="AGUARDANDO CONEXÃO" styleClass="phase-label" />
            <Label fx:id="messageLabel" text="Conecte-se à mesa para acompanhar a partida." styleClass="message-label" />
         </HBox>

         <HBox alignment="CENTER_LEFT" styleClass="players-heading">
            <Label text="02  /  MÃOS DOS JOGADORES" styleClass="players-title" />
            <Label fx:id="playersCountLabel" text="MESA  /  00 JOGADORES" styleClass="player-count" />
         </HBox>
         <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="players-scroll" VBox.vgrow="ALWAYS">
            <content>
               <HBox fx:id="playerSeats" spacing="12" styleClass="player-row" />
            </content>
         </ScrollPane>
      </VBox>
   </center>

   <bottom>
      <VBox spacing="10" styleClass="action-panel">
         <Label text="AÇÕES DA MESA" styleClass="action-caption" />
         <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="betField" prefWidth="150" promptText="Valor da aposta" />
            <Button fx:id="betButton" text="CONFIRMAR APOSTA" onAction="#onBet" />
            <Button fx:id="startRoundButton" text="INICIAR RODADA" onAction="#onStartRound" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="hitButton" text="PEDIR CARTA" styleClass="action-button, secondary-button" onAction="#onHit" />
            <Button fx:id="standButton" text="PARAR" styleClass="action-button, danger-button" onAction="#onStand" />
         </HBox>
      </VBox>
   </bottom>
   <padding>
      <Insets top="10" right="10" bottom="10" left="10" />
   </padding>
</BorderPane>