<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.blackjack.client.controllers.ClientController">
   <children>

      <!-- Mesa: feltro + borda curva em faixas (desenhada só com CSS) -->
      <Region styleClass="table-rim" mouseTransparent="true" />

      <BorderPane styleClass="table-layer" pickOnBounds="false">

         <!-- HUD superior: abas escuras nos cantos -->
         <top>
            <HBox alignment="TOP_LEFT" pickOnBounds="false" styleClass="hud-bar">
               <HBox alignment="CENTER_LEFT" spacing="12" styleClass="hud-tab, hud-tab-left">
                  <Label text="[♣]" styleClass="brand-mark" />
                  <Label text="BLACKJACK 21" styleClass="brand" />
                  <Label fx:id="connectionLabel" text="OFFLINE" styleClass="connection-label" />
               </HBox>
               <Region HBox.hgrow="ALWAYS" mouseTransparent="true" />
               <HBox alignment="CENTER_LEFT" spacing="8" styleClass="hud-tab, hud-tab-right">
                  <Label text="SERVIDOR" styleClass="field-label" />
                  <TextField fx:id="serverIpField" prefWidth="130" text="localhost" promptText="IP do servidor" />
                  <Label text="JOGADOR" styleClass="field-label" />
                  <TextField fx:id="playerNameField" prefWidth="130" promptText="Seu nome" />
                  <Button fx:id="connectButton" text="CONECTAR" onAction="#onConnect" />
               </HBox>
            </HBox>
         </top>

         <!-- Centro: dealer em cima, jogadores embaixo -->
         <center>
            <VBox alignment="TOP_CENTER" spacing="14" styleClass="table-area">
               <VBox alignment="TOP_CENTER" spacing="10" styleClass="dealer-panel">
                  <HBox alignment="CENTER" spacing="18" styleClass="dealer-heading">
                     <Label text="DEALER" styleClass="dealer-title" />
                     <Label fx:id="dealerScoreLabel" text="PONTUAÇÃO  /  --" styleClass="score-label" />
                  </HBox>
                  <HBox fx:id="dealerCards" alignment="CENTER" spacing="-10" styleClass="card-row" />
               </VBox>

               <HBox alignment="CENTER" spacing="14" styleClass="status-strip">
                  <Label fx:id="phaseLabel" text="AGUARDANDO CONEXÃO" styleClass="phase-label" />
                  <Label fx:id="messageLabel" text="Conecte-se à mesa para acompanhar a partida." styleClass="message-label" />
               </HBox>

               <HBox alignment="CENTER" spacing="14" styleClass="players-heading">
                  <Label text="MÃOS DOS JOGADORES" styleClass="players-title" />
                  <Label fx:id="playersCountLabel" text="MESA  /  00 JOGADORES" styleClass="player-count" />
               </HBox>
               <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="players-scroll" VBox.vgrow="ALWAYS">
                  <content>
                     <HBox fx:id="playerSeats" spacing="14" styleClass="player-row" />
                  </content>
               </ScrollPane>
            </VBox>
         </center>

         <!-- Rodapé: aposta à esquerda, PEDIR/PARAR à direita (sobre a borda da mesa) -->
         <bottom>
            <HBox alignment="BOTTOM_LEFT" spacing="16" pickOnBounds="false" styleClass="action-panel">
               <VBox spacing="8" styleClass="bet-panel">
                  <Label text="APOSTA" styleClass="action-caption" />
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <TextField fx:id="betField" prefWidth="130" promptText="Valor" />
                     <Button fx:id="betButton" text="CONFIRMAR" styleClass="gold-button" onAction="#onBet" />
                     <Button fx:id="startRoundButton" text="INICIAR RODADA" styleClass="gold-button" onAction="#onStartRound" />
                  </HBox>
               </VBox>
               <Region HBox.hgrow="ALWAYS" mouseTransparent="true" />
               <HBox alignment="BOTTOM_RIGHT" spacing="12">
                  <Button fx:id="hitButton" text="+ PEDIR" styleClass="action-button, secondary-button" onAction="#onHit" />
                  <Button fx:id="standButton" text="PARAR" styleClass="action-button, danger-button" onAction="#onStand" />
               </HBox>
            </HBox>
         </bottom>

      </BorderPane>
   </children>
</StackPane>
