<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #0b6623;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.blackjack.client.ClientController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label text="BLACKJACK 21" textFill="WHITE">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>

   <!-- Mão do Dealer -->
   <VBox alignment="CENTER" spacing="5.0" style="-fx-border-color: white; -fx-border-radius: 5; -fx-padding: 10;">
      <Label text="MÃO DO DEALER" textFill="YELLOW">
         <font><Font name="System Bold" size="14.0" /></font>
      </Label>
      <Label fx:id="lblPontosDealer" text="Pontos: 0" textFill="WHITE" />
      <Label fx:id="lblCartasDealer" text="[ Cartas ]" textFill="WHITE">
         <font><Font size="16.0" /></font>
      </Label>
   </VBox>

   <!-- Status do Jogo -->
   <Label fx:id="lblMensagem" text="Faça uma aposta para iniciar!" textFill="GOLD">
      <font><Font name="System Bold" size="14.0" /></font>
   </Label>

   <!-- Mão do Jogador -->
   <VBox alignment="CENTER" spacing="5.0" style="-fx-border-color: white; -fx-border-radius: 5; -fx-padding: 10;">
      <Label fx:id="lblNomeJogador" text="JOGADOR" textFill="CYAN">
         <font><Font name="System Bold" size="14.0" /></font>
      </Label>
      <Label fx:id="lblPontosJogador" text="Pontos: 0" textFill="WHITE" />
      <Label fx:id="lblCartasJogador" text="[ Cartas ]" textFill="WHITE">
         <font><Font size="16.0" /></font>
      </Label>
   </VBox>

   <!-- Painel de Apostas -->
   <HBox alignment="CENTER" spacing="15.0">
      <Label fx:id="lblSaldo" text="Saldo: $1000.0" textFill="WHITE">
         <font><Font name="System Bold" size="14.0" /></font>
      </Label>
      <TextField fx:id="txtAposta" prefWidth="100.0" promptText="Valor" />
      <Button fx:id="btnApostar" onAction="#handleApostar" text="Apostar" />
   </HBox>

   <!-- Botões de Ação -->
   <HBox alignment="CENTER" spacing="15.0">
      <Button fx:id="btnPedir" disable="true" onAction="#handlePedir" text="Pedir Carta (Hit)" />
      <Button fx:id="btnParar" disable="true" onAction="#handleParar" text="Parar (Stand)" />
      <Button fx:id="btnNovaRodada" disable="true" onAction="#handleNovaRodada" text="Nova Rodada" />
   </HBox>
</VBox>